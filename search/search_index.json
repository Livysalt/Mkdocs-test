8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#_2","title":"\u5efa\u7f51\u6b65\u9aa4","text":"<p>\u63a5\u4e0b\u6765\u5c06\u8bf4\u660e\u5982\u4f55\u4f7f\u7528vscode\u548cmkdocs\u5efa\u7acb\u7f51\u7ad9</p>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#mkdocs","title":"\u7b2c\u4e00\u6b65\uff1a\u5b89\u88c5mkdocs","text":"<ol> <li>\u6253\u5f00 VS Code \uff0c\u70b9\u51fb\u5de6\u4e0a\u89d2 \u7ec8\u7aef\uff0c\u9009\u62e9 \u65b0\u5efa\u7ec8\u7aef </li> <li>\u8f93\u5165\u4ee5\u4e0b\u4ee3\u7801\u540e\u70b9\u51fb\u56de\u8f66\uff1a</li> </ol> <p><code>pip3 install mkdocs \u6216\u8005 pip install mkdocs</code></p>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#mkdocs-material","title":"\u7b2c\u4e8c\u6b65\uff1a\u5b89\u88c5mkdocs material","text":"<p>\u5728\u7ec8\u7aef\u8f93\u5165\u4ee5\u4e0b\u4ee3\u7801\u540e\u70b9\u51fb\u56de\u8f66\uff1a</p> <p><code>pip3 install mkdocs-material \u6216\u8005 pip install mkdocs-material</code></p> <p>\u8fd9\u4e00\u6b65\u53ef\u540e\u7eed\u5728mkdocs-material\u7684\u7f51\u7ad9\u4e0a\u4fee\u6539\u6240\u9700\u8981\u7684\u4e3b\u9898</p>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#_3","title":"\u7b2c\u4e09\u6b65\uff1a\u5b9a\u4f4d\u50a8\u5b58\u4f4d\u7f6e","text":"<ol> <li>\u70b9\u51fb \u8bbf\u8fbe     \u9009\u62e9\u6587\u4ef6\u5b58\u653e\u5904\uff0c\u5982 \u201c\u6587\u7a3f\u201d\uff0c\u65b0\u5efa\u6587\u4ef6\u5939\uff0c\u5e76\u547d\u540d\uff0c\u5982 \"\u7f51\u7ad9Mkdocs\"     </li> <li>\u70b9\u51fb\u8fdb\u5165\u65b0\u6587\u4ef6\u5939 \"\u7f51\u7ad9Mkdocs\"\uff0c\u590d\u5236\u6587\u4ef6\u5939\u4f4d\u7f6e</li> <li>\u8fdb\u5165\u7ec8\u7aef\uff0c\u8f93\u5165\u4ee5\u4e0b\u4ee3\u7801\u8fdb\u5165\u6587\u4ef6\u5939\u4f4d\u7f6e\uff1a</li> </ol> <p><code>cd (\u7f51\u7ad9Mkdocs)</code></p>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#mkdocs_1","title":"\u7b2c\u56db\u6b65\uff1a\u65b0\u5efamkdocs\u9879\u76ee","text":"<ol> <li>\u8fdb\u5165\u6587\u4ef6\u5939\u4f4d\u7f6e\u540e\uff0c\u8f93\u5165\u4ee3\u7801\u540e\u70b9\u51fb\u56de\u8f66\uff1a   <code>mkdocs new my docs project</code></li> <li>\u6587\u4ef6\u5939\u5185\u51fa\u73b0\u4ee5\u4e0b\u5185\u5bb9\uff0c\u8bf4\u660e\u65b0\u5efa\u6210\u529f\uff1a    </li> </ol>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#_4","title":"\u7b2c\u4e94\u6b65\uff1a\u751f\u6210\u7f51\u7ad9","text":"<ol> <li>\u70b9\u51fb\u8fdb\u5165\u201cmy docs project\u201d\u6587\u4ef6\u5939\uff0c\u590d\u5236\u6587\u4ef6\u5939\u4f4d\u7f6e</li> <li>\u8fdb\u5165\u7ec8\u7aef\uff0c\u8f93\u5165\u4ee3\u7801\u8fdb\u5165\u6587\u4ef6\u5939\u4f4d\u7f6e\uff1a    <code>cd (my docs project)</code></li> <li>\u8fdb\u5165\u6210\u529f\u540e\uff0c\u8f93\u5165\u4ee3\u7801\u540e\u70b9\u51fb\u56de\u8f66     <code>mkdocs serve</code></li> <li>\u51fa\u73b0 \"serving on http://xxx\"\uff0c\u8bf4\u660e\u5efa\u7acb\u6210\u529f</li> </ol>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Mac%E7%B3%BB%E7%BB%9F%E5%BB%BA%E7%AB%8Bmkdocs/#_5","title":"\u4e00\u4e9b\u8bf4\u660e","text":"<p>\u672c\u7bc7\u7684\u5185\u5bb9\u6574\u5408\u4e8e\u4ee5\u4e0bb\u7ad9bilibili.com up\u4e3b\u7684\u6559\u7a0b\u548c\u672c\u4eba\u7684\u5b9e\u8df5\u7ecf\u8fc7\uff1a</p> up\u4e3b\u540d\u79f0 BV\u53f7 NextDeep BV1JYNZeNEy4 Wcowin BV1RNcgeVEJ7 8047- BV1FB4y1n7Gf"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/Troubleshooting/","title":"Troubleshooting","text":"<p>\u53ef\u80fd\u4f1a\u9047\u5230\u7684\u95ee\u9898</p> <p>The followings are the problems I met during building my own website, and here are some solutions to solve. Hope it can help you. \u4ee5\u4e0b\u662f\u6211\u81ea\u5df1\u5236\u4f5c\u8fc7\u7a0b\u4e2d\u9047\u5230\u7684\u95ee\u9898\u5e76\u4e14\u67e5\u627e\u7684\u89e3\u51b3\u529e\u6cd5\uff0c\u5e0c\u671b\u5bf9\u4f60\u6709\u5e2e\u52a9\u3002</p> \u95ee\u9898 \u53ef\u80fd\u7684\u89e3\u51b3\u529e\u6cd5 \u5df2\u7ecf\u5b89\u88c5python\u73af\u5883\uff0c\u4f46\u65e0\u6cd5\u8fd0\u884cpip\u6307\u4ee4 \u5c06pip\u6539\u4e3apip3 \u5982\u4f55\u590d\u5236mac\u7cfb\u7edf\u6587\u4ef6\u5939\u8def\u5f84 \u70b9\u51fb\u76ee\u6807\u6587\u4ef6\u5939\uff0cOption+command+c\u590d\u5236\uff0cCommand+v \u7c98\u8d34\u5230\u7ec8\u7aef \u65b0\u5efa\u7ec8\u7aef\u4f4d\u7f6e \u4f4d\u4e8eVSCode\u9996\u9875\uff0c\u70b9\u51fb\u201c\u7ec8\u7aef\u201d\uff0c\u9009\u62e9\u201c\u65b0\u5efa\u7ec8\u7aef\u201d <p>\u6ce8\u610f\uff1a\u8bf7\u52ff\u4ece\u5176\u4ed6\u4f4d\u7f6e\u65b0\u5efa\u7ec8\u7aef\uff0c\u5426\u5219\u5c06\u5bfc\u81f4PATH\u4e0d\u540c\u800c\u65e0\u6cd5\u8fd0\u884c\u6307\u4ee4</p>"},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/%E5%85%B3%E4%BA%8E%E6%88%91/","title":"\u5173\u4e8e\u6211","text":""},{"location":"%E7%BD%91%E7%AB%99%E5%BB%BA%E7%AB%8B%E6%95%99%E7%A8%8B/%E5%85%B3%E4%BA%8E%E6%88%91/#_1","title":"\u5173\u4e8e\u6211\u7684\u66f4\u591a\u4fe1\u606f\u8bf7\u67e5\u9605\u7b80\u5386","text":"<ul> <li>Master's degree from Hong Kong Baptist University</li> <li>Fluent in English and Chinese</li> <li>Learning the knowledge of Technical Writing on my own</li> <li>Possessed the HK ID and IANG working visa</li> </ul>"}]}